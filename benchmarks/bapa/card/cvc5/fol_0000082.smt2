
(set-logic ALL)
(declare-const u!6 Int)
(declare-const u!7 Int)
(declare-const u!8 Int)
(declare-const u!10 Int)
(declare-const u!11 Int)
(declare-const u!13 Int)
(declare-const u!14 Int)
(declare-const u!15 Int)
(declare-const b_di!2!9 Int)
(declare-const UNIVERALSET!1!5 Int)
(declare-const f!0!4 Int)
(declare-const b_dh!3!12 Int)
(declare-const t Int)
(declare-const n Int)
(assert (>= u!6 0))
(assert (>= u!7 0))
(assert (>= u!8 0))
(assert (>= u!10 0))
(assert (>= u!11 0))
(assert (>= u!13 0))
(assert (>= u!14 0))
(assert (>= u!15 0))
(assert (>= b_di!2!9 0))
(assert (>= UNIVERALSET!1!5 0))
(assert (>= f!0!4 0))
(assert (>= b_dh!3!12 0))
; A formulas
(assert (and (let ((a!1 (not (>= (* 2 u!15) (+ (- n t) 1)))))
  (and (= u!6 0)
       (= u!7 n)
       (> n 0)
       (> n (* 3 t))
       (<= u!8 t)
       (= u!10 0)
       (>= (* 2 u!11) (+ n (* 3 t) 1))
       (= u!13 0)
       (>= (* 2 u!14) (+ n (* 3 t) 1))
       a!1))
))
(assert 
  (int.star-contains 
    ((u!6_ Int)(u!7_ Int)(u!8_ Int)(u!10_ Int)(u!11_ Int)(u!13_ Int)(u!14_ Int)(u!15_ Int)(b_di!2!9_ Int)(UNIVERALSET!1!5_ Int)(f!0!4_ Int)(b_dh!3!12_ Int)) 
    (and 
      (= u!6_ (ite (> f!0!4_ UNIVERALSET!1!5_) 1 0))
      (= u!7_ UNIVERALSET!1!5_)
      (= u!8_ f!0!4_)
      (= u!10_ (ite (> b_di!2!9_ UNIVERALSET!1!5_) 1 0))
      (= u!11_ b_di!2!9_)
      (= u!13_ (ite (> b_dh!3!12_ UNIVERALSET!1!5_) 1 0))
      (= u!14_ b_dh!3!12_)
      (= u!15_ (ite (>= b_di!2!9_ b_dh!3!12_) b_dh!3!12_ b_di!2!9_))
      (>= f!0!4_ 0)
      (>= UNIVERALSET!1!5_ 0)
      (>= b_di!2!9_ 0)
      (>= b_dh!3!12_ 0)
      ) 
    (tuple u!6 u!7 u!8 u!10 u!11 u!13 u!14 u!15 b_di!2!9 UNIVERALSET!1!5 f!0!4 b_dh!3!12 )))
(check-sat)