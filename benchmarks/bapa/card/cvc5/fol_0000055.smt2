; A formulas
(assert (and (let ((a!1 (not (>= (* 2 u!19) (+ (- n t) 1)))))
  (and (= u!7 0)
       (= u!8 n)
       (> n 0)
       (> n (* 3 t))
       (<= u!9 t)
       (= u!11 0)
       (>= (* 2 u!12) (+ n (* 3 t) 1))
       (= u!14 0)
       (>= u!15 (- n t))
       (= u!17 0)
       (>= u!18 (- n t))
       a!1))
))
(assert 
  (int.star-contains 
    ((u!7_ Int)(u!8_ Int)(u!9_ Int)(u!11_ Int)(u!12_ Int)(u!14_ Int)(u!15_ Int)(u!17_ Int)(u!18_ Int)(u!19_ Int)(a_bp!3!13_ Int)(a_bo!4!16_ Int)(b_bq!2!10_ Int)(UNIVERALSET!1!6_ Int)(f!0!5_ Int)) 
    (and 
      (= u!7_ (ite (> f!0!5_ UNIVERALSET!1!6_) 1 0))
      (= u!8_ UNIVERALSET!1!6_)
      (= u!9_ f!0!5_)
      (= u!11_ (ite (> b_bq!2!10_ UNIVERALSET!1!6_) 1 0))
      (= u!12_ b_bq!2!10_)
      (= u!14_ (ite (> a_bp!3!13_ UNIVERALSET!1!6_) 1 0))
      (= u!15_ a_bp!3!13_)
      (= u!17_ (ite (> a_bo!4!16_ UNIVERALSET!1!6_) 1 0))
      (= u!18_ a_bo!4!16_)
      (let ((a!1 (ite (>= (ite (>= b_bq!2!10_ a_bp!3!13_) a_bp!3!13_ b_bq!2!10_)
                    a_bo!4!16_)
                a_bo!4!16_
                (ite (>= b_bq!2!10_ a_bp!3!13_) a_bp!3!13_ b_bq!2!10_))))
  (= u!19_ a!1))
      (>= f!0!5_ 0)
      (>= UNIVERALSET!1!6_ 0)
      (>= b_bq!2!10_ 0)
      (>= a_bp!3!13_ 0)
      (>= a_bo!4!16_ 0)
      ) 
    (tuple u!7 u!8 u!9 u!11 u!12 u!14 u!15 u!17 u!18 u!19 a_bp!3!13 a_bo!4!16 b_bq!2!10 UNIVERALSET!1!6 f!0!5 )))
