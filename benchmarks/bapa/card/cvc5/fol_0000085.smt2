
(set-logic ALL)
(declare-const u!5 Int)
(declare-const u!6 Int)
(declare-const u!7 Int)
(declare-const u!9 Int)
(declare-const u!10 Int)
(declare-const u!11 Int)
(declare-const c_dn!2!8 Int)
(declare-const UNIVERALSET!1!4 Int)
(declare-const f!0!3 Int)
(declare-const t Int)
(declare-const n Int)
(assert (>= u!5 0))
(assert (>= u!6 0))
(assert (>= u!7 0))
(assert (>= u!9 0))
(assert (>= u!10 0))
(assert (>= u!11 0))
(assert (>= c_dn!2!8 0))
(assert (>= UNIVERALSET!1!4 0))
(assert (>= f!0!3 0))
; A formulas
(assert (and (and (= u!5 0)
     (= u!6 n)
     (> n 0)
     (> n (* 3 t))
     (<= u!7 t)
     (= u!9 0)
     (>= (* 2 u!10) (+ (- n t) 1))
     (= u!11 0))
))
(assert 
  (int.star-contains 
    ((u!5_ Int)(u!6_ Int)(u!7_ Int)(u!9_ Int)(u!10_ Int)(u!11_ Int)(c_dn!2!8_ Int)(UNIVERALSET!1!4_ Int)(f!0!3_ Int)) 
    (and 
      (= u!5_ (ite (> f!0!3_ UNIVERALSET!1!4_) 1 0))
      (= u!6_ UNIVERALSET!1!4_)
      (= u!7_ f!0!3_)
      (= u!9_ (ite (> c_dn!2!8_ UNIVERALSET!1!4_) 1 0))
      (= u!10_ c_dn!2!8_)
      (let ((a!1 (ite (>= c_dn!2!8_
                    (ite (<= UNIVERALSET!1!4_ f!0!3_) 0 (- UNIVERALSET!1!4_ f!0!3_)))
                (ite (<= UNIVERALSET!1!4_ f!0!3_) 0 (- UNIVERALSET!1!4_ f!0!3_))
                c_dn!2!8_)))
  (= u!11_ a!1))
      (>= f!0!3_ 0)
      (>= UNIVERALSET!1!4_ 0)
      (>= c_dn!2!8_ 0)
      ) 
    (tuple u!5 u!6 u!7 u!9 u!10 u!11 c_dn!2!8 UNIVERALSET!1!4 f!0!3 )))
(check-sat)