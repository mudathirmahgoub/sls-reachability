
(set-logic ALL)
(declare-const u!4 Int)
(declare-const u!5 Int)
(declare-const u!6 Int)
(declare-const f!0!2 Int)
(declare-const UNIVERALSET!1!3 Int)
(declare-const t Int)
(declare-const n Int)
(assert (>= u!4 0))
(assert (>= u!5 0))
(assert (>= u!6 0))
(assert (>= f!0!2 0))
(assert (>= UNIVERALSET!1!3 0))
; A formulas
(assert (and (and (= u!4 0)
     (= u!5 n)
     (> n 0)
     (> n (* 3 t))
     (<= u!6 t)
     (< (- u!6 0) n)
     (> n 0))
))
(assert 
  (int.star-contains 
    ((u!4_ Int)(u!5_ Int)(u!6_ Int)(f!0!2_ Int)(UNIVERALSET!1!3_ Int)) 
    (and 
      (= u!4_ (ite (> f!0!2_ UNIVERALSET!1!3_) 1 0))
      (= u!5_ UNIVERALSET!1!3_)
      (= u!6_ f!0!2_)
      (>= f!0!2_ 0)
      (>= UNIVERALSET!1!3_ 0)
      ) 
    (tuple u!4 u!5 u!6 f!0!2 UNIVERALSET!1!3 )))
(check-sat)