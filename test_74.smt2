(set-logic HO_ALL)
(declare-const a Int)
(declare-const b Int)
(declare-const c Int)
(declare-const d Int)
(declare-const e Int)
(declare-const g Int)
(declare-const h Int)
(declare-const i Int)
(declare-const U Int)
(declare-const f Int)
(declare-const A Int)
(declare-const B Int)
(declare-const t Int)
(declare-const n Int)
(assert (= n 4))
(assert (= t 1))
(assert (>= a 0))
(assert (>= b 0))
(assert (>= c 0))
(assert (>= d 0))
(assert (>= e 0))
(assert (>= g 0))
(assert (>= h 0))
(assert (>= i 0))
(assert (>= U 0))
(assert (>= f 0))
(assert (>= A 0))
(assert (>= B 0))
; A formulas
(assert (and (and (= a 0)
     (= b n)
     (> n 0)
     (> n (* 3 t))
     (<= c t)
     (= d 0)
     (>= (* 2 e) (+ (- n t) 1))
     (= g 0)
     (>= (* 2 h) (+ n (* 3 t) 1))
     (not (>= i (- n t))))
))
(assert 
  ((int.star 
    (lambda ((a Int)(b Int)(c Int)(d Int)(e Int)(g Int)(h Int)(i Int)(U Int)(f Int)(A Int)(B Int)) 
      (and 
        (= a (ite (> f U) 1 0))
        (= b (ite (> U 0) 1 0))
        (= c (ite (> f 0) 1 0))
        (= d (ite (> B U) 1 0))
        (= e (ite (> B 0) 1 0))
        (= g (ite (> A U) 1 0))
        (= h (ite (> A 0) 1 0))
        (let ((a!1 (ite (>= (ite (>= B A) A B)
                    (ite (<= U f) 0 (- U f)))
                (ite (<= U f) 0 (- U f))
                (ite (>= B A) A B))))
          (= i (ite (> a!1 0) 1 0)))
        (>= f 0)
        (>= U 0)
        (>= B 0)
        (>= A 0)
        )))
    a b c d e g h i U f A B ))
(check-sat)
